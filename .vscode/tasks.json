{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilation Continue (Watch Mode)",
      "type": "shell",
      "command": "latexmk",
      "args": [
        "-xelatex",
        "-pvc",
        "-view=none",
        "-synctex=1",
        "-interaction=nonstopmode",
        "main.tex"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "latex",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*):(\\d+):\\s+(?:(Fatal error)|(Error)|(Warning)):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 6
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Latexmk: applying rule",
          "endsPattern": "Latexmk: All targets \\(.*\\) are up-to-date"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "Compiler une fois (main.tex)",
      "type": "shell",
      "command": "latexmk",
      "args": [
        "-xelatex",
        "-synctex=1",
        "-interaction=nonstopmode",
        "main.tex"
      ],
      "group": "build",
      "problemMatcher": "$latex",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
